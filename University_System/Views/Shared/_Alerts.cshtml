@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success" role="alert" style="margin-bottom:var(--space-5);">
        <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        <div class="alert-content">@successMessage</div>
    </div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert" style="margin-bottom:var(--space-5);">
        <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
        </svg>
        <div class="alert-content">@errorMessage</div>
    </div>
}
