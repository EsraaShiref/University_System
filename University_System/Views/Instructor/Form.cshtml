@model University_System.ViewModels.InstructorFormViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add Instructor" : "Edit Instructor";
    var courses = (SelectList)ViewData["Courses"]!;
}

<nav aria-label="breadcrumb" style="margin-bottom:var(--space-4);">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Instructors</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(isNew ? "Add" : "Edit")</li>
    </ol>
</nav>

<div class="page-header">
    <div class="page-header__meta">
        <h1 class="page-title">@ViewData["Title"]</h1>
        <p class="page-subtitle" style="margin-bottom:0;">The instructor automatically joins the department of the selected course.</p>
    </div>
</div>

<div class="card" style="max-width:760px;">
    <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? (int?)null : Model.Id)" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:var(--space-4);"></div>
        <input type="hidden" asp-for="Id" />

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:0 var(--space-6);">
            <div class="form-group">
                <label asp-for="InsName" class="form-label"></label>
                <input asp-for="InsName" class="form-control" />
                <span asp-validation-for="InsName" class="text-danger" style="font-size:var(--text-sm);"></span>
            </div>
            <div class="form-group">
                <label asp-for="CourseId" class="form-label"></label>
                <select asp-for="CourseId" asp-items="courses" class="form-select">
                    <option value="">Select a course…</option>
                </select>
                <span asp-validation-for="CourseId" class="text-danger" style="font-size:var(--text-sm);"></span>
            </div>
            <div class="form-group">
                <label asp-for="Salary" class="form-label"></label>
                <input asp-for="Salary" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Salary" class="text-danger" style="font-size:var(--text-sm);"></span>
            </div>
            <div class="form-group">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger" style="font-size:var(--text-sm);"></span>
            </div>
            <div class="form-group" style="grid-column:1 / -1;">
                <label asp-for="ImageFile" class="form-label"></label>
                <div style="display:flex;align-items:center;gap:var(--space-4);flex-wrap:wrap;">
                    <partial name="_Avatar" model='new AvatarViewModel { Name = Model.InsName, FileName = Model.Img, Folder = "instructors", Size = "avatar-xl" }' />
                    <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" style="flex:1 1 240px;" />
                </div>
                <div class="form-text">JPG, PNG, WEBP or GIF, up to 2 MB. Leave empty to keep the current photo.</div>
                <span asp-validation-for="ImageFile" class="text-danger" style="font-size:var(--text-sm);"></span>
            </div>
        </div>

        <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;margin-top:var(--space-2);">
            <button type="submit" class="btn btn-primary">@(isNew ? "Create" : "Save changes")</button>
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
