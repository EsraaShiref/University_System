@model University_System.ViewModels.DepartmentDetailsViewModel
@{
    var d = Model.Department;
    ViewData["Title"] = d.Name;
}

<nav aria-label="breadcrumb" style="margin-bottom:var(--space-4);">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Departments</a></li>
        <li class="breadcrumb-item active" aria-current="page">@d.Name</li>
    </ol>
</nav>

<div class="page-header">
    <div class="page-header__meta">
        <span class="text-eyebrow">Department</span>
        <h1 class="page-title">@d.Name</h1>
        <p class="page-subtitle" style="margin-bottom:0;">Managed by <strong>@d.Manager</strong></p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn-secondary" asp-action="Index">Back to list</a>
    </div>
</div>

<!-- Summary stats -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="stat-card animate-fade-in-up delay-1">
            <div class="stat-card__header">
                <span class="stat-card__label">Courses</span>
                <div class="stat-card__icon stat-card__icon--accent">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                    </svg>
                </div>
            </div>
            <div class="stat-card__value">@Model.Courses.Count</div>
            <div class="stat-card__trend"><span class="stat-card__trend-label">Offered by this department</span></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card animate-fade-in-up delay-2">
            <div class="stat-card__header">
                <span class="stat-card__label">Instructors</span>
                <div class="stat-card__icon stat-card__icon--success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 3.741-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" />
                    </svg>
                </div>
            </div>
            <div class="stat-card__value">@Model.Instructors.Count</div>
            <div class="stat-card__trend"><span class="stat-card__trend-label">Faculty members</span></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card animate-fade-in-up delay-3">
            <div class="stat-card__header">
                <span class="stat-card__label">Students</span>
                <div class="stat-card__icon stat-card__icon--primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                    </svg>
                </div>
            </div>
            <div class="stat-card__value">@Model.Trainees.Count</div>
            <div class="stat-card__trend"><span class="stat-card__trend-label">Registered trainees</span></div>
        </div>
    </div>
</div>

<!-- Courses (full width) -->
<div class="table-wrapper mb-4">
    <div class="table-toolbar">
        <span class="table-toolbar__title">Courses</span>
        <span class="badge badge-accent">@Model.Courses.Count</span>
    </div>
    @if (Model.Courses.Any())
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Total Degree</th>
                    <th>Min Degree</th>
                    <th>Instructors</th>
                    <th>Trainees</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Courses)
                {
                    <tr>
                        <td style="font-weight:var(--weight-medium);">@c.Name</td>
                        <td>@c.Degree</td>
                        <td>@c.MinDegree</td>
                        <td><span class="badge badge-success">@c.Instructors.Count</span></td>
                        <td><span class="badge badge-primary">@c.courseResults.Count</span></td>
                        <td style="text-align:right;">
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Courses" asp-action="Details" asp-route-id="@c.Id">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <h3 class="empty-state__title">No courses</h3>
            <p class="empty-state__description">This department has no courses yet.</p>
        </div>
    }
</div>

<!-- Instructors + Students side by side -->
<div class="row g-4">
    <div class="col-lg-7">
        <div class="table-wrapper">
            <div class="table-toolbar">
                <span class="table-toolbar__title">Instructors</span>
                <span class="badge badge-success">@Model.Instructors.Count</span>
            </div>
            @if (Model.Instructors.Any())
            {
                <table class="table table-hover">
                    <thead>
                        <tr><th>Instructor</th><th>Course</th><th>Salary</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model.Instructors)
                        {
                            <tr>
                                <td>
                                    <div style="display:flex;align-items:center;gap:var(--space-3);">
                                        <partial name="_Avatar" model='new AvatarViewModel { Name = i.InsName, FileName = i.Img, Folder = "instructors", Size = "avatar-md" }' />
                                        <a asp-controller="Instructor" asp-action="Details" asp-route-id="@i.Id" style="font-weight:var(--weight-medium);">@i.InsName</a>
                                    </div>
                                </td>
                                <td>
                                    <a asp-controller="Courses" asp-action="Details" asp-route-id="@i.CourseId"><span class="badge badge-accent">@i.Course.Name</span></a>
                                </td>
                                <td>@i.Salary.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <h3 class="empty-state__title">No instructors</h3>
                    <p class="empty-state__description">This department has no instructors yet.</p>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="table-wrapper">
            <div class="table-toolbar">
                <span class="table-toolbar__title">Students</span>
                <span class="badge badge-primary">@Model.Trainees.Count</span>
            </div>
            @if (Model.Trainees.Any())
            {
                <table class="table table-hover">
                    <thead>
                        <tr><th>Student</th><th>Grade</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Trainees)
                        {
                            <tr>
                                <td>
                                    <div style="display:flex;align-items:center;gap:var(--space-3);">
                                        <partial name="_Avatar" model='new AvatarViewModel { Name = t.Name, FileName = t.Image, Folder = "trainees", Size = "avatar-md" }' />
                                        <a asp-controller="Students" asp-action="Details" asp-route-id="@t.Id" style="font-weight:var(--weight-medium);">@t.Name</a>
                                    </div>
                                </td>
                                <td>@t.Grade</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <h3 class="empty-state__title">No students</h3>
                    <p class="empty-state__description">This department has no students yet.</p>
                </div>
            }
        </div>
    </div>
</div>
