@model CourseResult
@{
    ViewData["Title"] = "Result Details";
    var passed = Model.Degree >= Model.Course.MinDegree;
    var labelStyle = "font-size:var(--text-xs);font-weight:var(--weight-semibold);text-transform:uppercase;letter-spacing:var(--tracking-wider);color:var(--text-muted);margin-bottom:var(--space-1);";
    var valueStyle = "font-size:var(--text-base);color:var(--text-primary);margin:0;";
}

<nav aria-label="breadcrumb" style="margin-bottom:var(--space-4);">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Course Results</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Trainee.Name &middot; @Model.Course.Name</li>
    </ol>
</nav>

<div class="page-header">
    <div class="page-header__meta">
        <h1 class="page-title">Result Details</h1>
        <p class="page-subtitle" style="margin-bottom:0;">A trainee's degree in one course.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <button type="button" class="btn btn-danger" data-delete-url="@Url.Action("Delete", new { id = Model.Id })">Delete</button>
        <a class="btn btn-secondary" asp-action="Index">Back to list</a>
    </div>
</div>

<div class="card" style="max-width:760px;">
    <div class="card-header">
        <div style="display:flex;align-items:center;gap:var(--space-4);">
            <partial name="_Avatar" model='new AvatarViewModel { Name = Model.Trainee.Name, FileName = Model.Trainee.Image, Folder = "trainees", Size = "avatar-xl" }' />
            <div>
                <h2 class="card-title" style="font-size:var(--text-xl);">@Model.Trainee.Name</h2>
                <p class="card-subtitle">@Model.Trainee.Department.Name</p>
            </div>
        </div>
        @if (passed)
        {
            <span class="badge badge-success">Passed</span>
        }
        else
        {
            <span class="badge badge-danger">Failed</span>
        }
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--space-6);">
        <div>
            <div style="@labelStyle">Student</div>
            <a asp-controller="Students" asp-action="Details" asp-route-id="@Model.TraineeId">@Model.Trainee.Name</a>
        </div>
        <div>
            <div style="@labelStyle">Course</div>
            <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">@Model.Course.Name</a>
        </div>
        <div>
            <div style="@labelStyle">Degree</div>
            <p style="@valueStyle">@Model.Degree / @Model.Course.Degree</p>
        </div>
        <div>
            <div style="@labelStyle">Passing Degree</div>
            <p style="@valueStyle">@Model.Course.MinDegree</p>
        </div>
    </div>
</div>
