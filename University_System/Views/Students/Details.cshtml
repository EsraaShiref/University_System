@model University_System.ViewModels.TraineeDetailsViewModel
@{
    ViewData["Title"] = "Student Details";
    var t = Model.Trainee;
    var labelStyle = "font-size:var(--text-xs);font-weight:var(--weight-semibold);text-transform:uppercase;letter-spacing:var(--tracking-wider);color:var(--text-muted);margin-bottom:var(--space-1);";
    var valueStyle = "font-size:var(--text-base);color:var(--text-primary);margin:0;";
}

<nav aria-label="breadcrumb" style="margin-bottom:var(--space-4);">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Students</a></li>
        <li class="breadcrumb-item active" aria-current="page">@t.Name</li>
    </ol>
</nav>

<div class="page-header">
    <div class="page-header__meta">
        <h1 class="page-title">Student Details</h1>
        <p class="page-subtitle" style="margin-bottom:0;">Profile and course results.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn-secondary" asp-action="Index">Back to list</a>
    </div>
</div>

<div class="card" style="max-width:760px;margin-bottom:var(--space-6);">
    <div class="card-header">
        <div style="display:flex;align-items:center;gap:var(--space-4);">
            <div class="avatar avatar-xl avatar--primary">
                @(string.IsNullOrEmpty(t.Name) ? "?" : t.Name.Substring(0, 1).ToUpper())
            </div>
            <div>
                <h2 class="card-title" style="font-size:var(--text-xl);">@t.Name</h2>
                <p class="card-subtitle">@t.Department.Name</p>
            </div>
        </div>
        <span class="badge badge-neutral">ID @t.Id</span>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:var(--space-6);">
        <div>
            <div style="@labelStyle">Department</div>
            <a asp-controller="Departments" asp-action="Details" asp-route-id="@t.DepartmentId">@t.Department.Name</a>
        </div>
        <div>
            <div style="@labelStyle">Grade</div>
            <p style="@valueStyle">@t.Grade</p>
        </div>
        <div>
            <div style="@labelStyle">Address</div>
            <p style="@valueStyle">@(string.IsNullOrWhiteSpace(t.Address) ? "—" : t.Address)</p>
        </div>
    </div>
</div>

<div class="table-wrapper">
    <div class="table-toolbar">
        <span class="table-toolbar__title">Course Results</span>
        <span class="badge badge-primary">@Model.Results.Count results</span>
    </div>

    @if (Model.Results.Any())
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Degree</th>
                    <th>Min Degree</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Results)
                {
                    <tr>
                        <td><a asp-controller="Courses" asp-action="Details" asp-route-id="@r.CourseId">@r.Course.Name</a></td>
                        <td>@r.Degree / @r.Course.Degree</td>
                        <td>@r.Course.MinDegree</td>
                        <td>
                            @if (r.Degree >= r.Course.MinDegree)
                            {
                                <span class="badge badge-success">Passed</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Failed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <h3 class="empty-state__title">No results yet</h3>
            <p class="empty-state__description">This student has no course results.</p>
        </div>
    }
</div>
