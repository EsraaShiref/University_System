@model Course
@{
    ViewData["Title"] = "Course Details";
    var labelStyle = "font-size:var(--text-xs);font-weight:var(--weight-semibold);text-transform:uppercase;letter-spacing:var(--tracking-wider);color:var(--text-muted);margin-bottom:var(--space-1);";
    var valueStyle = "font-size:var(--text-base);color:var(--text-primary);margin:0;";
}

<nav aria-label="breadcrumb" style="margin-bottom:var(--space-4);">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Courses</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="page-header">
    <div class="page-header__meta">
        <h1 class="page-title">Course Details</h1>
        <p class="page-subtitle" style="margin-bottom:0;">Course information, instructors and trainee results.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn-secondary" asp-action="Index">Back to list</a>
    </div>
</div>

<div class="card" style="max-width:760px;margin-bottom:var(--space-6);">
    <div class="card-header">
        <div>
            <h2 class="card-title" style="font-size:var(--text-xl);">@Model.Name</h2>
            <p class="card-subtitle">@Model.Department.Name</p>
        </div>
        <span class="badge badge-neutral">ID @Model.Id</span>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:var(--space-6);">
        <div>
            <div style="@labelStyle">Department</div>
            <a asp-controller="Departments" asp-action="Details" asp-route-id="@Model.DepartmentId">@Model.Department.Name</a>
        </div>
        <div>
            <div style="@labelStyle">Total Degree</div>
            <p style="@valueStyle">@Model.Degree</p>
        </div>
        <div>
            <div style="@labelStyle">Minimum Degree</div>
            <p style="@valueStyle">@Model.MinDegree</p>
        </div>
    </div>
</div>

<div class="table-wrapper" style="margin-bottom:var(--space-6);">
    <div class="table-toolbar">
        <span class="table-toolbar__title">Instructors</span>
        <span class="badge badge-primary">@Model.Instructors.Count</span>
    </div>

    @if (Model.Instructors.Any())
    {
        <table class="table table-hover">
            <thead>
                <tr><th>Name</th><th>Salary</th><th style="text-align:right;">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Instructors)
                {
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:var(--space-3);">
                                <partial name="_Avatar" model='new AvatarViewModel { Name = i.InsName, FileName = i.Img, Folder = "instructors", Size = "avatar-sm" }' />
                                @i.InsName
                            </div>
                        </td>
                        <td>@i.Salary.ToString("N2")</td>
                        <td style="text-align:right;">
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Instructor" asp-action="Details" asp-route-id="@i.Id">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <h3 class="empty-state__title">No instructors</h3>
            <p class="empty-state__description">No instructor teaches this course.</p>
        </div>
    }
</div>

<div class="table-wrapper">
    <div class="table-toolbar">
        <span class="table-toolbar__title">Trainee Results</span>
        <span class="badge badge-primary">@Model.courseResults.Count</span>
    </div>

    @if (Model.courseResults.Any())
    {
        <table class="table table-hover">
            <thead>
                <tr><th>Trainee</th><th>Degree</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.courseResults)
                {
                    <tr>
                        <td>
                            <a asp-controller="Students" asp-action="Details" asp-route-id="@r.TraineeId">@r.Trainee.Name</a>
                        </td>
                        <td>@r.Degree / @Model.Degree</td>
                        <td>
                            @if (r.Degree >= Model.MinDegree)
                            {
                                <span class="badge badge-success">Passed</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Failed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <h3 class="empty-state__title">No results yet</h3>
            <p class="empty-state__description">No trainee has a result in this course.</p>
        </div>
    }
</div>
