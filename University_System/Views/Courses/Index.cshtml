@model University_System.Helpers.PaginatedList<Course>
@{
    ViewData["Title"] = "Courses";
    var q = ViewData["q"] as string;
    var departments = (SelectList)ViewData["Departments"]!;
    var departmentId = ViewData["departmentId"] as int?;
    var filtered = !string.IsNullOrWhiteSpace(q) || departmentId.HasValue;
    var first = Model.Count == 0 ? 0 : (Model.PageIndex - 1) * Model.PageSize + 1;
    var last = first + Model.Count - 1;
}

<div class="page-header">
    <div class="page-header__meta">
        <h1 class="page-title">Courses</h1>
        <p class="page-subtitle" style="margin-bottom:0;">Search, add, edit and remove courses.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn-primary" asp-action="Create">Add Course</a>
    </div>
</div>

<div class="table-wrapper">
    <div class="table-toolbar">
        <span class="table-toolbar__title">All Courses</span>
        <span class="badge badge-primary">@Model.TotalCount total</span>
    </div>

    <form method="get" asp-action="Index" class="list-filters">
        <input type="search" name="q" value="@q" class="form-control" maxlength="100" placeholder="Search by course name…" />
        <select name="departmentId" class="form-select" asp-items="departments">
            <option value="">All departments</option>
        </select>
        <button type="submit" class="btn btn-primary">Search</button>
        @if (filtered)
        {
            <a class="btn btn-secondary" asp-action="Index">Clear</a>
        }
    </form>

    @if (Model.Count > 0)
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Department</th>
                    <th>Degree</th>
                    <th>Min Degree</th>
                    <th>Instructors</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><span style="font-weight:var(--weight-medium);">@c.Name</span></td>
                        <td>@c.Department.Name</td>
                        <td>@c.Degree</td>
                        <td>@c.MinDegree</td>
                        <td><span class="badge badge-success">@c.Instructors.Count</span></td>
                        <td style="text-align:right;white-space:nowrap;">
                            <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@c.Id">Details</a>
                            <a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                            <button type="button" class="btn btn-danger btn-sm" data-delete-url="@Url.Action("Delete", new { id = c.Id })">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="table-footer">
            <span class="table-footer__count">Showing @(first)&ndash;@(last) of @Model.TotalCount</span>
            <partial name="_Pagination" model="Model" />
        </div>
    }
    else
    {
        <div class="empty-state">
            <h3 class="empty-state__title">@(filtered ? "No matching results" : "No courses yet")</h3>
            <p class="empty-state__description">@(filtered ? "Try a different search or clear the filters." : "Use the button above to add the first one.")</p>
        </div>
    }
</div>
